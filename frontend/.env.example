# Dev proxy target: the Express backend (Person B). Its API.md states :3000.
VITE_API_PROXY=http://localhost:3000

# Set when the frontend is deployed and the API lives on another origin,
# e.g. https://foodbridge-api.example.com — leave blank to use the dev proxy.
VITE_API_BASE=

# Give up on a request after this many ms.
VITE_API_TIMEOUT=15000
